# Orbit Backend Environment Configuration

PROJECT_NAME="Orbit Backend API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration
# For local SQLite (default fallback):
DATABASE_URL="sqlite:///./orbit.db"
# For Supabase / PostgreSQL:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# JWT & Authentication
SECRET_KEY="orbit-super-secret-jwt-key-change-this-in-production-random-32-bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Admin User (auto-seeded if not present)
DEFAULT_ADMIN_EMAIL="admin@orbit.dev"
DEFAULT_ADMIN_PASSWORD="OrbitAdminPassword2026!"
DEFAULT_ADMIN_NAME="Orbit Admin"

# CORS Allowed Origins (comma-separated or JSON array)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000,https://website-codex-red.vercel.app"

# Optional AI Agent Providers (if provided, agent planner uses live LLM)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
